{
  "name": "placementportalait",
  "version": "1.0.0",
  "description": "Placement Portal AIT - unified Student, Admin, and TPC portal",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "seed": "node scripts/seed_roster.js",
    "test:part1": "npm test",
    "test:part2": "npm test",
    "test": "node --test --test-concurrency=1",
    "test:live": "node --test --test-concurrency=1 test/dob_fixes.test.js",
    "check": "node --check src/server.js && npm test",
    "deploy": "npx wrangler deploy",
    "deploy:dry-run": "npx wrangler deploy --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "fullcalendar": "^6.1.15",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pdf-lib": "1.17.1",
    "unpdf": "^1.0.6",
    "web-push": "3.6.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "supertest": "7.1.4",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
