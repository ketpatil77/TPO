{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tpo-placement-portal",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "ALLOWED_ORIGINS": "https://tpo-placement-portal.ketan-tpo-portal.workers.dev"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/login", "/dashboard", "/admin", "/admin/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
