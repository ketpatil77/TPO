{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ait",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "ALLOWED_ORIGINS": "https://ait.ait-placement-portal.workers.dev"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/login", "/dashboard", "/admin", "/admin/*", "/observer", "/observer/*"]
  },
  "kv_namespaces": [
    {
      "binding": "TPO_CACHE",
      "id": "3ce7e386abc24eceb2c09f9538243b48"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
